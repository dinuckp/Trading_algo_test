# Kite API Credentials
# CRITICAL: Never commit the actual .env file with real credentials
KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Trading Mode (CRITICAL SAFETY SETTINGS)
# Set to 'false' to run in mock/simulation mode (DEFAULT and RECOMMENDED for testing)
ENABLE_LIVE_ORDERS=false
# Must also pass --confirm-live CLI flag to enable live trading

# Throttling Configuration (orders per second/minute)
THROTTLE_ORDERS_PER_SEC=2
THROTTLE_ORDERS_PER_MIN=20

# Risk Management
MAX_TOTAL_EXPOSURE=500000
MAX_RISK_PER_TRADE=10000
MAX_POSITION_SIZE=50
MAX_VEGA_EXPOSURE=5000
MAX_DELTA_EXPOSURE=100
MARGIN_BUFFER_PERCENT=20

# Options Chain Cache TTL (seconds)
CACHE_TTL_ATM=30
CACHE_TTL_NEAR=60
CACHE_TTL_FAR=300

# WebSocket Configuration
WS_RECONNECT_MAX_DELAY=60000
WS_RECONNECT_MAX_TRIES=10

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_JSON=true

# Backtesting
BACKTEST_DATA_DIR=./data
BACKTEST_OUTPUT_DIR=./backtest_results

# Python Backtrader Integration (optional)
BACKTRADER_PYTHON_PATH=python3
BACKTRADER_SCRIPT_PATH=./backtest/backtrader_connector.py
